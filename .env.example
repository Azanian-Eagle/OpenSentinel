PORT=8080
RUST_LOG=info

# Comma-separated list of allowed frontend origins. Leave at localhost for local testing.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Required: 64 hex characters for the 32-byte AES-GCM key.
PAYLOAD_SECRET_KEY=0102030405060708090a0b4c0d0e0f101112131415161718191a1b1c1d1e1f20

# Directory used for the threat intel log and other runtime data.
DATA_DIR=data

# Rotate the threat intel log after it grows beyond this many bytes.
THREAT_INTEL_MAX_BYTES=5242880

# Simple per-IP request throttling for the verification endpoints.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional federation settings.
FEDERATION_ENABLED=false
TRUSTED_PEERS=
TRUSTED_PEERS_PUBKEYS=
NODE_PRIVATE_KEY=
NODE_URL=

# Optional override for the ONNX model path.
OPEN_SENTINEL_MODEL_PATH=/app/server/model.onnx

# Optional override for the client/static assets directory.
# For release bundles this is rewritten to client by the packaging workflow.
OPEN_SENTINEL_CLIENT_DIR=/app/client